# ─── Lead delivery ───────────────────────────────────────────────
# The form at /#apply posts to /api/apply. Configure AT LEAST ONE of
# the two channels below, or leads are only written to the Vercel logs.

# Option A — email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
LEAD_NOTIFICATION_EMAIL=you@closingking.com
# Must be an address on a domain you've verified in Resend.
# Omit it and it falls back to Resend's shared onboarding@resend.dev sender.
LEAD_FROM_EMAIL=ClosingKing <leads@closingking.com>

# Option B — POST every lead to a webhook (Zapier, Make, Slack, your CRM)
LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/xxxxxx

# ─── Public (exposed to the browser) ─────────────────────────────
# Your canonical URL — used for SEO metadata and social preview cards.
NEXT_PUBLIC_SITE_URL=https://closingking.com

# YouTube/Vimeo EMBED url for the hero VSL. Leave unset and the video
# card renders as a designed placeholder instead.
#   YouTube: https://www.youtube.com/embed/VIDEO_ID
#   Vimeo:   https://player.vimeo.com/video/VIDEO_ID
NEXT_PUBLIC_VIDEO_URL=

# Calendly / Cal.com link shown after someone submits the form.
NEXT_PUBLIC_CALENDAR_URL=
